appName = "phononTransport"

sumRuleFC2 = "simple"
phFC2FileName = "../qe-phonons/silicon.fc"
phFC3FileName = "../thirdorder.py-anharmonic/FORCE_CONSTANTS_3RD"

electronH0Name = "../../Silicon-el/qe-elph/si_tb.dat"
elphFileName = "../../Silicon-el/qe-elph/silicon.phoebe.elph.hdf5"

useSymmetries = true
kMesh = [25, 25, 25]
qMesh = [5, 5, 5]
temperatures = [100.]

smearingMethod = "gaussian"
smearingWidth = 25. cmm1
numOccupiedStates = 4
dopings = [1.e22]

solverBTE = ["iterative"]
scatteringMatrixInMemory = true

boundaryLength = 1. mum

windowType = "population"
windowPopulationLimit = 1e-3
